# ============================================================
# StarFlight Backend Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# ---- LLM Provider (OpenAI-compatible / DashScope) ----
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_API_KEY=your-dashscope-api-key-here
DASHSCOPE_API_KEY=your-dashscope-api-key-here
CHAT_MODEL=qwen-turbo

# ---- Embedding Provider (same API as LLM) ----
# Uses the same CHAT_BASE_URL + CHAT_API_KEY
# Supported DashScope models: text-embedding-v1, text-embedding-v2
EMBEDDING_MODEL=text-embedding-v1

# ---- RAG Retrieval Settings ----
# Cosine distance threshold (0=identical, 1=unrelated)
RAG_SIMILARITY_THRESHOLD=0.55
# Top-K documents to retrieve per query
RAG_TOP_K=3

# ---- 3D Avatar Engine (OpenAvatarChat, optional) ----
OPENAVATAR_BASE_URL=http://127.0.0.1:8282

# ---- Server ----
HOST=0.0.0.0
PORT=5000

# ---- Optional: Local Embedding ----
# If you have PyTorch + VC++ Runtime installed:
#   EMBEDDING_PROVIDER=local
#   EMBEDDING_MODEL=all-MiniLM-L6-v2
# Otherwise the cloud embedding API is used (recommended).
